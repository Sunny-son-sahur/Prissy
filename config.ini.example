[DEFAULT]
# set to false and fill TEST_GUILD_ID to sync globally instead of a test guild
TESTING = true
TEST_GUILD_ID = 0

# discord bot token
TOKEN =

# role id that can use the owner-only /admin commands.
# in Discord: Server Settings > Roles > (right-click a role) > Copy Role ID
# (enable Developer Mode first: Settings > Advanced > Developer Mode)
# 0 = nobody (except the bot's application owner)
admin_role = 0

# ffmpeg paths — optional.
# by default the bot finds ffmpeg/ffprobe on your PATH (recommended:
# `winget install ffmpeg` on Windows, then they resolve automatically).
# only fill these in if ffmpeg is NOT on your PATH.
# FFMPEG_PATH =
# FFPROBE_PATH =
